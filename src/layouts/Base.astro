---
interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
  locale?: 'zh' | 'en';
  alternateZh?: string;
  alternateEn?: string;
  noindex?: boolean;
  jsonLd?: object | object[];
}

import { i18n, ogLocale } from '../i18n.ts';
import { withBase, absUrl, hasBasePath } from '../base.ts';
import { organizationSchema, websiteSchema } from '../seo/schema.ts';

const {
  locale = 'zh',
  title = i18n[locale].seo.homeTitle,
  description = i18n[locale].seo.homeDescription,
  ogImage = '/og-image.png',
  canonical = Astro.url.href,
  alternateZh,
  alternateEn,
  noindex = false,
  jsonLd,
} = Astro.props as Props;

const t = i18n[locale];
const ogImageUrl = absUrl(ogImage, Astro.site);

// 子路径部署（GitHub Pages 项目站点）＝ 预览环境：整站 noindex，避免与
// tokenfleet.cn 构成重复内容抢排名。切回自定义域名（base 为空）后自动恢复可索引。
const isNoindex = noindex || hasBasePath;

// 站点级结构化数据始终输出；页面可经 `jsonLd` prop 追加自有 schema
// （供子任务 B 注入 Product / ItemList）。
const siteSchemas = [
  organizationSchema(Astro.site!),
  websiteSchema(Astro.site!),
];
const pageSchemas = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const jsonLdBlocks = [...siteSchemas, ...pageSchemas];

import '../styles/global.css';
import '../styles/buttons.css';
import '../styles/tailwind.css';
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="theme-color" content="#533afd" />
    <meta name="generator" content={Astro.generator} />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href={withBase('/favicon-32.png')}
    />
    <link
      rel="icon"
      type="image/png"
      sizes="48x48"
      href={withBase('/favicon-48.png')}
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href={withBase('/apple-touch-icon.png')}
    />
    <link rel="canonical" href={canonical} />
    {isNoindex && <meta name="robots" content="noindex" />}
    {
      alternateZh && (
        <link rel="alternate" hreflang="zh-CN" href={alternateZh} />
      )
    }
    {alternateEn && <link rel="alternate" hreflang="en" href={alternateEn} />}
    {
      alternateZh && (
        <link rel="alternate" hreflang="x-default" href={alternateZh} />
      )
    }

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={ogLocale(locale)} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="TokenFleet" />
    <meta property="og:image" content={ogImageUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {
      jsonLdBlocks.map((schema) => (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(schema)}
        />
      ))
    }

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body>
    <a href="#main" class="skip-link">{t.skipToMain}</a>
    <slot />

    <style is:global>
      .skip-link {
        position: absolute;
        top: -100px;
        left: 16px;
        z-index: 999;
        background: var(--color-primary);
        color: var(--color-on-primary);
        padding: 10px 16px;
        border-radius: var(--radius-md);
        font-family: var(--font-mono);
        font-size: 13px;
        transition: top 200ms var(--ease-out-quart);
      }
      .skip-link:focus-visible {
        top: 16px;
      }
    </style>

    <script>
      const prefersReduced = window.matchMedia(
        '(prefers-reduced-motion: reduce)'
      ).matches;
      const reveals = Array.from(
        document.querySelectorAll<HTMLElement>('[data-reveal]')
      );

      if (
        !prefersReduced &&
        reveals.length &&
        'IntersectionObserver' in window
      ) {
        // Only engage reveal animation when JS + IO + motion are all available.
        document.documentElement.classList.add('js-reveal');

        // Anything currently in (or above) the initial viewport is treated as
        // already-revealed — avoids a flash on hard refresh near the fold.
        const vh = window.innerHeight;
        reveals.forEach((el) => {
          const rect = el.getBoundingClientRect();
          if (rect.top < vh * 0.95) {
            el.classList.add('is-visible');
          }
        });

        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -6% 0px', threshold: 0.05 }
        );

        reveals.forEach((el) => {
          if (!el.classList.contains('is-visible')) {
            io.observe(el);
          }
        });

        // Safety net: if anything is still hidden after 2.5s (e.g. headless
        // screenshot tools that don't simulate scroll), force-reveal it.
        window.setTimeout(() => {
          reveals.forEach((el) => el.classList.add('is-visible'));
        }, 2500);
      }
    </script>
  </body>
</html>
