---
/**
 * Wordmark.astro — TokenFleet wordmark.
 * Combines the company mark with semantic brand text so nav/footer get the
 * optimized logo asset without sacrificing screen-reader clarity.
 */

interface Props {
  size?: 'sm' | 'md' | 'lg';
  variant?: 'on-light' | 'on-dark';
  class?: string;
  locale?: 'zh' | 'en';
}

import { i18n, localePath } from '../i18n.ts';
import { withBase } from '../base.ts';

const {
  size = 'md',
  variant = 'on-light',
  class: className = '',
  locale = 'zh',
} = Astro.props as Props;
const t = i18n[locale];
---

<a
  href={withBase(localePath(locale, '/'))}
  class={`wordmark wordmark--${size} wordmark--${variant} ${className}`}
  aria-label={t.homeAria}
>
  <picture class="wordmark__mark" aria-hidden="true">
    <source srcset={withBase('/xy-mark-small.webp')} type="image/webp" />
    <img
      class="wordmark__mark-img"
      src={withBase('/xy-mark-small.png')}
      width="160"
      height="110"
      alt=""
      decoding="async"
      loading="eager"
    />
  </picture>
  <span class="wordmark__text">
    <span class="wordmark__token">Token</span><span class="wordmark__fleet"
      >Fleet</span
    ><span class="wordmark__dot" aria-hidden="true">.</span>
  </span>
</a>

<style>
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 32px;
    font-family: var(--font-sans);
    font-weight: var(--weight-medium);
    letter-spacing: -0.018em;
    line-height: 1;
    text-decoration: none;
    color: var(--color-ink);
  }

  .wordmark--sm {
    gap: 7px;
    font-size: 18px;
  }

  .wordmark--md {
    font-size: 22px;
  }

  .wordmark--lg {
    gap: 10px;
    font-size: 32px;
  }

  .wordmark__mark {
    display: block;
    flex: 0 0 auto;
    width: 34px;
    height: 24px;
    line-height: 0;
    overflow: hidden;
  }

  .wordmark--sm .wordmark__mark {
    width: 30px;
    height: 21px;
  }

  .wordmark--lg .wordmark__mark {
    width: 48px;
    height: 33px;
  }

  .wordmark__mark-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .wordmark__text {
    display: inline-flex;
    align-items: baseline;
  }

  .wordmark--on-dark {
    color: var(--color-on-primary);
  }
  .wordmark--on-dark .wordmark__token {
    color: var(--color-on-primary);
  }

  .wordmark__token {
    color: var(--color-ink);
  }

  .wordmark__fleet {
    color: var(--color-primary);
  }

  .wordmark__dot {
    color: var(--color-primary);
    margin-left: 1px;
    line-height: 1;
  }

  .wordmark:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 4px;
    border-radius: var(--radius-xs);
  }
</style>
