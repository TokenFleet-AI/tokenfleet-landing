---
import { i18n, type Locale } from '../i18n.ts';

interface Props {
  locale?: Locale;
}

const { locale = 'zh' } = Astro.props as Props;
const t = i18n[locale];
const logos = [
  ['deepseek-color.svg', 'DeepSeek'],
  ['kimi-color.svg', 'Kimi · Moonshot'],
  ['minimax-color.svg', 'MiniMax'],
  ['zhipu-color.svg', locale === 'en' ? 'Zhipu GLM' : '智谱 GLM'],
];
const loop = [...logos, ...logos];
---

<section class="brandstrip" aria-labelledby="brandstrip-title">
  <div class="container brandstrip__inner">
    <p class="eyebrow eyebrow--mute" id="brandstrip-title">
      {t.brandStrip.title}
    </p>
    <div class="brandstrip__loop" aria-label={t.brandStrip.aria}>
      <div class="brandstrip__track">
        {
          loop.map(([file, label], index) => (
            <img
              src={`/ai-brand-logo/${file}`}
              alt={index < logos.length ? label : ''}
              loading="lazy"
              aria-hidden={index >= logos.length ? 'true' : undefined}
            />
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .brandstrip {
    background: var(--color-canvas);
    padding-block: clamp(24px, 3vw, 40px);
    border-top: 1px solid var(--color-hairline);
    border-bottom: 1px solid var(--color-hairline);
  }

  .brandstrip__inner {
    display: flex;
    flex-direction: column;
    gap: clamp(18px, 2.2vw, 28px);
  }

  .brandstrip__loop {
    position: relative;
    height: clamp(64px, 7vw, 92px);
    display: flex;
    align-items: center;
    overflow: hidden;
    mask-image: linear-gradient(
      90deg,
      transparent,
      #000 12%,
      #000 88%,
      transparent
    );
  }

  .brandstrip__track {
    display: flex;
    align-items: center;
    gap: clamp(44px, 6vw, 72px);
    width: max-content;
    animation: brandstrip-scroll 22s linear infinite;
  }

  .brandstrip__track img {
    height: clamp(52px, 5.2vw, 72px);
    width: auto;
    flex: 0 0 auto;
  }

  @keyframes brandstrip-scroll {
    to {
      transform: translateX(calc(-50% - clamp(44px, 6vw, 72px) / 2));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .brandstrip__track {
      animation: none;
    }
  }

  @media (max-width: 640px) {
    .brandstrip {
      padding-block: 22px 28px;
    }

    .brandstrip__loop {
      height: 64px;
    }

    .brandstrip__track img {
      height: 48px;
    }
  }
</style>
