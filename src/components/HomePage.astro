---
import Base from '../layouts/Base.astro';
import TopNav from './TopNav.astro';
import Hero from './Hero.astro';
import BrandStrip from './BrandStrip.astro';
import FeaturedModels from './FeaturedModels.astro';
import TriCard from './TriCard.astro';
import WhyUs from './WhyUs.astro';
import Enterprise from './Enterprise.astro';
import Faq from './Faq.astro';
import Footer from './Footer.astro';
import { i18n, localePath, type Locale } from '../i18n.ts';
import { absUrl } from '../base.ts';
import { faqPageSchema } from '../seo/faq-schema.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props as Props;
const t = i18n[locale];
---

<Base
  locale={locale}
  title={t.seo.homeTitle}
  description={t.seo.homeDescription}
  canonical={absUrl(localePath(locale, '/'), Astro.site)}
  alternateZh={absUrl('/', Astro.site)}
  alternateEn={absUrl('/en', Astro.site)}
  jsonLd={faqPageSchema(t.faq.items)}
>
  <TopNav locale={locale} currentPath="/" />
  <main id="main">
    <Hero locale={locale} />
    <BrandStrip locale={locale} />
    <FeaturedModels locale={locale} />
    <TriCard locale={locale} />
    <WhyUs locale={locale} />
    <Enterprise locale={locale} />
    <Faq locale={locale} />
  </main>
  <Footer locale={locale} />
</Base>
