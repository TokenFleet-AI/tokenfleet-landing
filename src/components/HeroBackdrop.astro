---
/** Static light-purple hero background. */
---

<div class="hero-bg" aria-hidden="true">
  <div class="hero-bg__field"></div>
  <div class="hero-bg__grid"></div>
  <div class="hero-bg__vignette"></div>
</div>

<style>
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: var(--z-mesh);
    overflow: hidden;
    background: #f8f6ff;
    contain: layout paint;
    pointer-events: none;
  }

  .hero-bg__field,
  .hero-bg__grid,
  .hero-bg__vignette {
    position: absolute;
    inset: 0;
  }

  .hero-bg__field {
    background:
      radial-gradient(
        ellipse at 18% 24%,
        rgba(125, 109, 255, 0.28),
        transparent 62%
      ),
      radial-gradient(
        ellipse at 82% 72%,
        rgba(249, 107, 238, 0.14),
        transparent 58%
      ),
      radial-gradient(
        ellipse at 52% 8%,
        rgba(255, 255, 255, 0.82),
        transparent 52%
      );
  }

  .hero-bg__grid {
    opacity: 0.18;
    background-image:
      linear-gradient(rgba(83, 58, 253, 0.16) 1px, transparent 1px),
      linear-gradient(90deg, rgba(83, 58, 253, 0.16) 1px, transparent 1px);
    background-size: 32px 32px;
    mask-image: radial-gradient(ellipse at 50% 45%, #000 0%, transparent 72%);
  }

  .hero-bg__vignette {
    background: radial-gradient(
      ellipse at 50% 60%,
      rgba(255, 255, 255, 0) 34%,
      rgba(255, 255, 255, 0.18) 78%,
      rgba(255, 255, 255, 0.42) 100%
    );
  }
</style>
