                <text x="24" y="32">{t.product.invoice.chop[0]}</text>
                <text x="48" y="32">{t.product.invoice.chop[1]}</text>
                <text x="24" y="56">{t.product.invoice.chop[2]}</text>
                <text x="48" y="56">{t.product.invoice.chop[3]}</text>
