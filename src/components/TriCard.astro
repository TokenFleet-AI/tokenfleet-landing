                stroke-width="1"
                stroke-dasharray="2 2"></line>
            </svg>

            <table class="invoice__table">
              <tbody>
                <tr>
                  <td>DeepSeek · deepseek-v4-pro</td>
                  <td class="invoice__num mono tabular"
                    ><span data-amt="3842.50">¥&thinsp;3,842.50</span></td
