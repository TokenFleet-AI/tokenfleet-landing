                </tr>
                <tr>
                  <td>Moonshot · kimi-k2.6</td>
                  <td class="invoice__num mono tabular"
                    ><span data-amt="5217.30">¥&thinsp;5,217.30</span></td
                  >
                </tr>
                <tr>
                  <td>MiniMax · MiniMax-M2.7</td>
                  <td class="invoice__num mono tabular"
                    ><span data-amt="1498.00">¥&thinsp;1,498.00</span></td
                  >
                </tr>
                <tr>
                  <td>智谱 · glm-5.1</td>
                  <td class="invoice__num mono tabular"
                    ><span data-amt="612.80">¥&thinsp;612.80</span></td
                  >
                </tr>
              </tbody>
              <tfoot>
                <tr>
                  <td>{t.product.invoice.total}</td>
                  <td class="invoice__total mono tabular"
                    ><span data-amt="11170.60">¥&thinsp;11,170.60</span></td
                  >
                </tr>
              </tfoot>
            </table>

            <svg
              class="invoice__rule invoice__rule--foot"
              viewBox="0 0 100 1"
              preserveAspectRatio="none"
              aria-hidden="true"
            >
              <line
                x1="0"
                y1="0.5"
                x2="100"
                y2="0.5"
                stroke="currentColor"
                stroke-width="1"
                stroke-dasharray="2 2"></line>
            </svg>

            <div class="invoice__foot mono">
              <span>{t.product.invoice.buyer}</span>
              <span>{t.product.invoice.date}</span>
            </div>
          </figure>

          <ul class="tri-card__bullets">
            {billing.bullets?.map((item) => <li>{item}</li>)}
          </ul>

          <a
            href={`${localePath(locale, '/')}#business`}
            class="btn btn--outline-indigo btn--sm tri-card__cta"
          >
            {billing.cta}
            <svg
              width="11"
              height="11"
              viewBox="0 0 11 11"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M3.5 2l3 3.5-3 3.5"
                stroke="currentColor"
                stroke-width="1.4"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </a>
        </div>
      </li>

      {/* Card 3 — GPU Coming-soon */}
      <li
        class="tri-card tri-card--soon"
        data-reveal
        style="--reveal-delay:160ms"
      >
        <div class="tri-card__inner">
          <span class="eyebrow eyebrow--mute">{gpu.eyebrow}</span>
          <h3 class="tri-card__title">{gpu.title}</h3>
          <p class="tri-card__body">
            {gpu.body}
          </p>

          <div class="tri-card__media tri-card__media--rack" aria-hidden="true">
            <svg
              viewBox="0 0 240 140"
