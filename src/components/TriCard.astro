              {/* faint in-progress hatch background */}
              <rect
                x="0"
                y="0"
                width="240"
                height="140"
                fill="url(#rack-stripes)"></rect>

              {/* three rack units */}
              <g class="rack__units">
                {
                  [18, 88, 158].map((x, i) => (
                    <g
                      class={`rack-unit rack-unit--${i}`}
                      transform={`translate(${x}, 14)`}
                    >
                      {/* outer frame */}
                      <rect
                        x="0"
                        y="0"
                        width="64"
                        height="112"
                        rx="3"
                        fill="var(--color-canvas)"
                        stroke="var(--color-hairline-strong)"
                        stroke-width="1"
                      />

                      {/* top status band */}
                      <rect
                        x="0"
                        y="0"
                        width="64"
                        height="12"
                        rx="3"
                        fill="var(--color-canvas-soft)"
                      />
                      <line
                        x1="0"
                        y1="12"
                        x2="64"
                        y2="12"
                        stroke="var(--color-hairline)"
                        stroke-width="0.6"
                      />

                      {/* status LED — breathes out of phase */}
                      <circle
                        class="rack-led"
                        cx="56"
                        cy="6"
                        r="1.8"
                        fill="var(--color-primary)"
                      />

                      {/* tiny mounting screws on top band */}
                      <circle
                        cx="6"
                        cy="6"
                        r="0.9"
                        fill="var(--color-hairline-strong)"
                      />

                      {/* vent slats */}
                      <g
                        stroke="var(--color-hairline-strong)"
                        stroke-width="0.6"
                        stroke-linecap="round"
                      >
                        <line x1="10" y1="26" x2="54" y2="26" />
                        <line x1="10" y1="32" x2="54" y2="32" />
                        <line x1="10" y1="38" x2="54" y2="38" />
                        <line x1="10" y1="44" x2="54" y2="44" />
                        <line x1="10" y1="50" x2="54" y2="50" />
                        <line x1="10" y1="56" x2="54" y2="56" />
                      </g>

                      {/* model label band */}
                      <line
                        x1="0"
                        y1="72"
                        x2="64"
                        y2="72"
                        stroke="var(--color-hairline)"
                        stroke-width="0.6"
                      />
                      <text
                        x="32"
                        y="86"
                        text-anchor="middle"
                        font-family="var(--font-mono)"
                        font-size="10"
                        font-weight="500"
                        fill="var(--color-ink-secondary)"
                      >
                        {i === 0 ? 'H100' : 'H200'}
                      </text>
                      <text
                        x="32"
                        y="100"
                        text-anchor="middle"
                        font-family="var(--font-mono)"
                        font-size="8"
                        fill="var(--color-ink-mute)"
                      >
                        {i === 0 ? '80GB' : '141GB'}
                      </text>
                    </g>
                  ))
                }
              </g>
            </svg>
          </div>

          <div class="gpu-contact">
            <a
              href={`mailto:sales@tokenfleet.cn?subject=${encodeURIComponent(gpuSubject)}`}
              class="btn btn--outline-indigo btn--sm gpu-contact__btn"
            >
              {gpu.cta}
            </a>
            <p class="gpu-contact__note mono">sales@tokenfleet.cn</p>
          </div>
        </div>
      </li>
    </ol>
  </div>
</section>

<script>
  /* Count-up: animate invoice numbers when the figure enters view. */
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const invoiceLocale = document.documentElement.lang || 'zh-CN';
  const formatRMB = (n: number) =>
    '¥\u2009' +
    n.toLocaleString(invoiceLocale, {
      minimumFractionDigits: 2,
      maximumFractionDigits: 2,
    });

  function animateValue(el: HTMLElement) {
    const target = parseFloat(el.dataset.amt ?? '');
    if (!Number.isFinite(target)) return;
    const dur = 760;
    const start = performance.now();
    const ease = (t: number) => 1 - Math.pow(1 - t, 5); // ease-out-quint
    const step = (now: number) => {
      const t = Math.min(1, (now - start) / dur);
      el.textContent = formatRMB(target * ease(t));
      if (t < 1) requestAnimationFrame(step);
      else el.textContent = formatRMB(target);
    };
    requestAnimationFrame(step);
  }

  function init() {
    const invoice = document.querySelector<HTMLElement>('[data-invoice-anim]');
    if (!invoice) return;
    const cells = Array.from(
      invoice.querySelectorAll<HTMLElement>('[data-amt]')
    );

    if (reduced || !('IntersectionObserver' in window)) {
      // leave the static markup as-is — already shows the final value
      return;
    }

    // Hide initial values so the count-up reads as a real animation, not a flicker.
    cells.forEach((el) => {
      el.textContent = formatRMB(0);
    });

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            cells.forEach((el, i) => {
              setTimeout(() => animateValue(el), i * 90);
            });
            io.disconnect();
          }
        });
      },
      { threshold: 0.35 }
    );
    io.observe(invoice);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>

<style>
  .tri {
    background: var(--color-canvas);
    border-top: 1px solid var(--color-hairline);
  }

  .tri__inner {
    display: flex;
    flex-direction: column;
    gap: clamp(40px, 5vw, 64px);
  }

  .tri__header {
    max-width: 660px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .tri__title {
    font-size: var(--type-display-lg-size);
    line-height: var(--type-display-lg-line);
    letter-spacing: var(--type-display-lg-track);
    font-weight: var(--weight-thin);
    color: var(--color-ink);
  }

  .tri__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  /* per-card reveal stagger — applied in both states so the delay value is
     read regardless of which state the browser reads transition-* from. */
  .js-reveal .tri__grid [data-reveal]:not(.is-visible),
  .js-reveal .tri__grid [data-reveal].is-visible {
    transition-delay: var(--reveal-delay, 0ms);
  }

  .tri-card {
    background: var(--color-canvas);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-lg);
    display: flex;
    transition:
      border-color var(--motion-base) var(--ease-out-quart),
      box-shadow var(--motion-base) var(--ease-out-quart),
      transform 320ms var(--ease-out-quart);
  }

  .tri-card:hover {
    border-color: var(--color-hairline-strong);
    box-shadow: var(--shadow-1);
    transform: translateY(-2px);
  }

  .tri-card--billing {
    background: var(--color-canvas-cream);
    border-color: var(--color-canvas-cream-deep);
  }
  .tri-card--billing:hover {
    border-color: var(--color-canvas-cream-deep);
    background: var(--color-canvas-cream);
  }

  .tri-card--soon {
    background: var(--color-canvas-soft);
    color: var(--color-ink-secondary);
  }
  .tri-card--soon:hover {
    box-shadow: none;
    transform: translateY(-2px);
  }
  .tri-card--soon .tri-card__title {
    color: var(--color-ink-secondary);
  }

  .tri-card__inner {
    flex: 1;
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .tri-card__title {
    font-size: var(--type-display-md-size);
    line-height: var(--type-display-md-line);
    letter-spacing: var(--type-display-md-track);
    font-weight: var(--weight-thin);
    color: var(--color-ink);
  }

  .tri-card__body {
    font-size: var(--type-body-md-size);
    color: var(--color-ink-secondary);
    line-height: 1.55;
    max-width: 32ch;
  }

  .tri-card__media {
    margin: 4px -8px 0;
  }

  .tri-card__media--schematic {
    padding: 4px 8px 8px;
  }

  .tri-card__bullets {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 8px;
  }

  .tri-card__bullets li {
    font-size: 13px;
    color: var(--color-ink-secondary);
    padding-left: 16px;
    position: relative;
    line-height: 1.5;
  }

  .tri-card__bullets li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 8px;
    width: 6px;
    height: 1.5px;
    background: var(--color-primary);
    border-radius: 999px;
  }

  .tri-card__cta {
    align-self: flex-start;
    margin-top: 8px;
  }

  /* ── Card 1: schematic ────────────────────────────────────────────────── */
  .schematic {
    width: 100%;
    height: auto;
    display: block;
  }

  .sch-path {
    stroke-dasharray: 110;
    stroke-dashoffset: 110;
    transition: stroke-dashoffset 900ms var(--ease-out-expo);
    transition-delay: 200ms;
  }
  .sch-path--out {
    stroke-dasharray: 24;
    stroke-dashoffset: 24;
    transition-delay: 600ms;
  }

  .schematic__chips .chip rect {
    transition: stroke 200ms var(--ease-out-quart);
  }
  .tri-card--primary:hover .schematic__chips .chip rect {
    stroke: var(--color-primary-bg-subdued-hover);
  }

  /* packets — calm convergence loop */
  .pkt {
    opacity: 0;
    animation-duration: 5s;
    animation-iteration-count: infinite;
    animation-timing-function: var(--ease-out-quart);
    animation-play-state: paused;
  }
  .pkt--v0 {
    animation-name: pkt-v0;
  }
  .pkt--v1 {
    animation-name: pkt-v1;
    animation-delay: 1.25s;
  }
  .pkt--v2 {
    animation-name: pkt-v2;
    animation-delay: 2.5s;
  }
  .pkt--v3 {
    animation-name: pkt-v3;
    animation-delay: 3.75s;
  }
  .pkt--out {
    animation-name: pkt-out;
    animation-duration: 1.25s;
    animation-timing-function: var(--ease-out-expo);
  }

  /* run packets only when the schematic has been revealed */
  .tri-card--primary.is-visible .pkt,
  /* fallback for no-JS / no-IO */
  html:not(.js-reveal) .tri-card--primary .pkt {
