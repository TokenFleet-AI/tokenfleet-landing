---
/**
 * TriCard.astro — three-up product breakdown.
 *
 * Card 1: 统一 API 网关 — vendor wordmark chips + indigo gateway pill +
 *         client node, connected by hairline paths that draw in on reveal.
 *         Packets flow vendor → gateway → client in a calm loop.
 * Card 2: 统一计费与发票 — mini 增值税专票 mockup with tabular figures,
 *         count-up on reveal, drawn-in dashed separators, faint indigo
 *         "对公专票" chop in the bottom-right.
 * Card 3: GPU 算力出租 — stylized rack with vent slats, capacity labels,
 *         status LEDs that breathe out-of-phase. COMING SOON state.
 */
import { i18n, localePath, type Locale } from '../i18n.ts';

interface Props {
  locale?: Locale;
}

const { locale = 'zh' } = Astro.props as Props;
const t = i18n[locale];
const [gateway, billing, gpu] = t.product.cards;
const gpuSubject =
  locale === 'zh' ? 'GPU 算力出租咨询' : 'GPU compute rental inquiry';
---

<section class="tri" id="products" aria-labelledby="tri-title">
  <div class="container tri__inner">
    <div class="tri__header" data-reveal>
      <span class="eyebrow eyebrow--mute">{t.product.eyebrow}</span>
      <h2 class="tri__title" id="tri-title">
        {t.product.title}
      </h2>
    </div>

    <ol class="tri__grid">
      {/* Card 1 — Unified API Gateway */}
      <li
        class="tri-card tri-card--primary"
        data-reveal
        style="--reveal-delay:0ms"
      >
        <div class="tri-card__inner">
          <span class="eyebrow">{gateway.eyebrow}</span>
          <h3 class="tri-card__title">{gateway.title}</h3>
          <p class="tri-card__body">
            {gateway.body}
          </p>

          <div
            class="tri-card__media tri-card__media--schematic"
            aria-hidden="true"
          >
            <svg
              viewBox="0 0 360 200"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
              class="schematic"
            >
              <defs>
                <linearGradient id="gw-gradient" x1="0" y1="0" x2="1" y2="0">
                  <stop offset="0%" stop-color="var(--color-primary-deep)"
                  ></stop>
                  <stop offset="100%" stop-color="var(--color-primary)"></stop>
                </linearGradient>
              </defs>

              {/* connector paths — drawn in on reveal via stroke-dashoffset */}
              <g
                class="schematic__paths"
                stroke="var(--color-hairline-strong)"
                stroke-width="1"
                stroke-linecap="round"
                fill="none"
              >
                <path class="sch-path" d="M106 30 L152 100"></path>
                <path class="sch-path" d="M106 70 L152 100"></path>
                <path class="sch-path" d="M106 130 L152 100"></path>
                <path class="sch-path" d="M106 170 L152 100"></path>
                <path class="sch-path sch-path--out" d="M284 100 L304 100"
                ></path>
              </g>

              {/* vendor chips */}
              <g
                class="schematic__chips"
                font-family="var(--font-mono)"
                font-size="10"
                fill="var(--color-ink-secondary)"
              >
                <g class="chip">
                  <rect
                    x="10"
                    y="18"
                    width="96"
                    height="24"
                    rx="4"
                    fill="var(--color-canvas)"
                    stroke="var(--color-hairline-strong)"></rect>
                  <circle
                    cx="22"
                    cy="30"
                    r="2.5"
                    fill="var(--color-ink-secondary)"></circle>
                  <text x="32" y="34">OpenAI</text>
                </g>
                <g class="chip">
                  <rect
                    x="10"
                    y="58"
                    width="96"
                    height="24"
                    rx="4"
                    fill="var(--color-canvas)"
                    stroke="var(--color-hairline-strong)"></rect>
                  <circle cx="22" cy="70" r="2.5" fill="var(--vendor-anthropic)"
                  ></circle>
                  <text x="32" y="74">Anthropic</text>
                </g>
                <g class="chip">
                  <rect
                    x="10"
                    y="118"
                    width="96"
                    height="24"
                    rx="4"
                    fill="var(--color-canvas)"
                    stroke="var(--color-hairline-strong)"></rect>
                  <circle cx="22" cy="130" r="2.5" fill="var(--vendor-google)"
                  ></circle>
                  <text x="32" y="134">Google</text>
