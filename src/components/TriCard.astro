---
/**
 * TriCard.astro — single-card product spotlight.
 *
 * 统一 API 网关: two-column layout — text on the left,
 * vendor-chips → gateway-pill → client schematic on the right.
 * Packets flow vendor → gateway → client in a calm loop.
 */
import { i18n, type Locale } from '../i18n.ts';
import { PRICING_URL } from '../site-links.ts';

interface Props {
  locale?: Locale;
}

const { locale = 'zh' } = Astro.props as Props;
const t = i18n[locale];
const [gateway] = t.product.cards;
---

<section class="tri" id="products" aria-labelledby="tri-title">
  <div class="container tri__inner">
    <div class="tri__header" data-reveal>
      <span class="eyebrow eyebrow--mute">{t.product.eyebrow}</span>
      <h2 class="tri__title" id="tri-title">
        {t.product.title}
      </h2>
    </div>

    <div class="tri-card tri-card--primary" data-reveal>
      <div class="tri-card__inner">
        <div class="tri-card__text">
          <span class="eyebrow">{gateway.eyebrow}</span>
          <h3 class="tri-card__title">{gateway.title}</h3>
          <p class="tri-card__body">
            {gateway.body}
          </p>

          <ul class="tri-card__bullets">
            {gateway.bullets?.map((item) => <li>{item}</li>)}
          </ul>

          <a
            href={PRICING_URL}
            class="btn btn--outline-indigo btn--sm tri-card__cta"
          >
            {gateway.cta}
            <svg
              width="11"
              height="11"
              viewBox="0 0 11 11"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M3.5 2l3 3.5-3 3.5"
                stroke="currentColor"
                stroke-width="1.4"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </a>
        </div>

        <div
          class="tri-card__media tri-card__media--schematic"
          aria-hidden="true"
        >
          <svg
            viewBox="0 0 360 200"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            class="schematic"
          >
            <defs>
              <linearGradient id="gw-gradient" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0%" stop-color="var(--color-primary-deep)"></stop>
                <stop offset="100%" stop-color="var(--color-primary)"></stop>
              </linearGradient>
            </defs>

            {/* connector paths — drawn in on reveal via stroke-dashoffset */}
            <g
              class="schematic__paths"
              stroke="var(--color-hairline-strong)"
              stroke-width="1"
              stroke-linecap="round"
              fill="none"
            >
              <path class="sch-path" d="M106 30 L152 100"></path>
              <path class="sch-path" d="M106 70 L152 100"></path>
              <path class="sch-path" d="M106 130 L152 100"></path>
              <path class="sch-path" d="M106 170 L152 100"></path>
              <path class="sch-path sch-path--out" d="M284 100 L304 100"></path>
            </g>

            {/* vendor chips */}
            <g
              class="schematic__chips"
              font-family="var(--font-mono)"
              font-size="10"
              fill="var(--color-ink-secondary)"
            >
              <g class="chip">
                <rect
                  x="10"
                  y="18"
                  width="96"
                  height="24"
                  rx="4"
                  fill="var(--color-canvas)"
                  stroke="var(--color-hairline-strong)"></rect>
                <circle
                  cx="22"
                  cy="30"
                  r="2.5"
                  fill="var(--color-ink-secondary)"></circle>
                <text x="32" y="34">OpenAI</text>
              </g>
              <g class="chip">
                <rect
                  x="10"
                  y="58"
                  width="96"
                  height="24"
                  rx="4"
                  fill="var(--color-canvas)"
                  stroke="var(--color-hairline-strong)"></rect>
                <circle cx="22" cy="70" r="2.5" fill="var(--vendor-anthropic)"
                ></circle>
                <text x="32" y="74">Anthropic</text>
              </g>
              <g class="chip">
                <rect
                  x="10"
                  y="118"
                  width="96"
                  height="24"
                  rx="4"
                  fill="var(--color-canvas)"
                  stroke="var(--color-hairline-strong)"></rect>
                <circle cx="22" cy="130" r="2.5" fill="var(--vendor-google)"
                ></circle>
                <text x="32" y="134">Google</text>
              </g>
              <g class="chip">
                <rect
                  x="10"
                  y="158"
                  width="96"
                  height="24"
                  rx="4"
                  fill="var(--color-canvas)"
                  stroke="var(--color-hairline-strong)"></rect>
                <circle cx="22" cy="170" r="2.5" fill="var(--color-ruby)"
                ></circle>
                <text x="32" y="174">BFL</text>
              </g>
            </g>

            {/* gateway pill — the visual anchor */}
            <g class="schematic__gateway">
              <rect
                x="152"
                y="82"
                width="132"
                height="36"
                rx="8"
                fill="url(#gw-gradient)"></rect>
              <text
                x="218"
                y="105"
                text-anchor="middle"
                font-family="var(--font-mono)"
                font-size="11"
                font-weight="500"
                fill="var(--color-on-primary)"
                letter-spacing="-0.01em"
              >
                tokenfleet.cn/v1
              </text>
            </g>

            {/* client */}
            <g class="schematic__client">
              <rect
                x="304"
                y="86"
                width="48"
                height="28"
                rx="4"
                fill="var(--color-canvas)"
                stroke="var(--color-ink)"
                stroke-width="1.1"></rect>
              <text
                x="328"
                y="104"
                text-anchor="middle"
                font-family="var(--font-mono)"
                font-size="10"
                fill="var(--color-ink)">your app</text
              >
            </g>

            {/* packets — vendor → gateway, then gateway → client */}
            <g class="schematic__packets" fill="var(--color-primary)">
              <circle class="pkt pkt--v0" cx="106" cy="30" r="2.4"></circle>
              <circle class="pkt pkt--v1" cx="106" cy="70" r="2.4"></circle>
              <circle class="pkt pkt--v2" cx="106" cy="130" r="2.4"></circle>
              <circle class="pkt pkt--v3" cx="106" cy="170" r="2.4"></circle>
              <circle class="pkt pkt--out" cx="284" cy="100" r="2.4"></circle>
            </g>
          </svg>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .tri {
    background: var(--color-canvas);
    border-top: 1px solid var(--color-hairline);
  }

  .tri__inner {
    display: flex;
    flex-direction: column;
    gap: clamp(40px, 5vw, 64px);
  }

  .tri__header {
    max-width: 660px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .tri__title {
    font-size: var(--type-display-lg-size);
    line-height: var(--type-display-lg-line);
    letter-spacing: var(--type-display-lg-track);
    font-weight: var(--weight-thin);
    color: var(--color-ink);
  }

  .tri-card {
    background: var(--color-canvas);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-lg);
    transition:
      border-color var(--motion-base) var(--ease-out-quart),
      box-shadow var(--motion-base) var(--ease-out-quart),
      transform 320ms var(--ease-out-quart);
  }

  .tri-card:hover {
    border-color: var(--color-hairline-strong);
    box-shadow: var(--shadow-1);
    transform: translateY(-2px);
  }

  .tri-card__inner {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: clamp(32px, 5vw, 56px);
    align-items: center;
    padding: clamp(32px, 5vw, 48px);
  }

  /* ── left column: text ─────────────────────────────────────────────────── */
  .tri-card__text {
    display: flex;
    flex-direction: column;
    gap: 18px;
    min-width: 0;
  }

  .tri-card__title {
    font-size: var(--type-display-md-size);
    line-height: var(--type-display-md-line);
    letter-spacing: var(--type-display-md-track);
    font-weight: var(--weight-thin);
    color: var(--color-ink);
  }

  .tri-card__body {
    font-size: var(--type-body-md-size);
    color: var(--color-ink-secondary);
    line-height: 1.55;
    max-width: 32ch;
  }

  .tri-card__bullets {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 8px;
  }

  .tri-card__bullets li {
    font-size: 13px;
    color: var(--color-ink-secondary);
    padding-left: 16px;
    position: relative;
    line-height: 1.5;
  }

  .tri-card__bullets li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 8px;
    width: 6px;
    height: 1.5px;
    background: var(--color-primary);
    border-radius: 999px;
  }

  .tri-card__cta {
    align-self: flex-start;
    margin-top: 8px;
  }

  /* ── right column: schematic ───────────────────────────────────────────── */
  .tri-card__media--schematic {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
  }

  .schematic {
    width: 100%;
    height: auto;
    display: block;
    max-height: 320px;
  }

  .sch-path {
    stroke-dasharray: 110;
    stroke-dashoffset: 110;
    transition: stroke-dashoffset 900ms var(--ease-out-expo);
    transition-delay: 200ms;
  }
  .sch-path--out {
    stroke-dasharray: 24;
    stroke-dashoffset: 24;
    transition-delay: 600ms;
  }

  .schematic__chips .chip rect {
    transition: stroke 200ms var(--ease-out-quart);
  }
  .tri-card--primary:hover .schematic__chips .chip rect {
    stroke: var(--color-primary-bg-subdued-hover);
  }

  /* packets — calm convergence loop */
  .pkt {
    opacity: 0;
    animation-duration: 5s;
    animation-iteration-count: infinite;
    animation-timing-function: var(--ease-out-quart);
    animation-play-state: paused;
  }
  .pkt--v0 {
    animation-name: pkt-v0;
  }
  .pkt--v1 {
    animation-name: pkt-v1;
    animation-delay: 1.25s;
  }
  .pkt--v2 {
    animation-name: pkt-v2;
    animation-delay: 2.5s;
  }
  .pkt--v3 {
    animation-name: pkt-v3;
    animation-delay: 3.75s;
  }
  .pkt--out {
    animation-name: pkt-out;
    animation-duration: 1.25s;
    animation-timing-function: var(--ease-out-expo);
  }

  .tri-card--primary.is-visible .pkt,
  html:not(.js-reveal) .tri-card--primary .pkt {
    animation-play-state: running;
  }

  .tri-card--primary.is-visible .sch-path {
    stroke-dashoffset: 0;
  }
  html:not(.js-reveal) .tri-card--primary .sch-path {
    stroke-dashoffset: 0;
  }

  @keyframes pkt-v0 {
    0% {
      transform: translate(0px, 0px);
      opacity: 0;
    }
    8% {
      opacity: 1;
    }
    55% {
      transform: translate(46px, 70px);
      opacity: 0.9;
    }
    60%,
    100% {
      transform: translate(46px, 70px);
      opacity: 0;
    }
  }
  @keyframes pkt-v1 {
    0% {
      transform: translate(0px, 0px);
      opacity: 0;
    }
    8% {
      opacity: 1;
    }
    55% {
      transform: translate(46px, 30px);
      opacity: 0.9;
    }
    60%,
    100% {
      transform: translate(46px, 30px);
      opacity: 0;
    }
  }
  @keyframes pkt-v2 {
    0% {
      transform: translate(0px, 0px);
      opacity: 0;
    }
    8% {
      opacity: 1;
    }
    55% {
      transform: translate(46px, -30px);
      opacity: 0.9;
    }
    60%,
    100% {
      transform: translate(46px, -30px);
      opacity: 0;
    }
  }
  @keyframes pkt-v3 {
    0% {
      transform: translate(0px, 0px);
      opacity: 0;
    }
    8% {
      opacity: 1;
    }
    55% {
      transform: translate(46px, -70px);
      opacity: 0.9;
    }
    60%,
    100% {
      transform: translate(46px, -70px);
      opacity: 0;
    }
  }
  @keyframes pkt-out {
    0% {
      transform: translate(0px, 0px);
      opacity: 0;
    }
    20% {
      opacity: 1;
    }
    80% {
      opacity: 1;
    }
    100% {
      transform: translate(20px, 0px);
      opacity: 0;
    }
  }

  /* ── reduced motion ─────────────────────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .sch-path {
      transition: none;
      stroke-dashoffset: 0;
      stroke-dasharray: none;
    }
    .pkt {
      animation: none;
      opacity: 0;
    }
    .tri-card:hover {
      transform: none;
    }
  }

  /* ── responsive ─────────────────────────────────────────────────────────── */
  @media (max-width: 768px) {
    .tri-card__inner {
      grid-template-columns: 1fr;
      gap: 28px;
      padding: 24px;
    }
    .tri-card__media--schematic {
      order: -1;
    }
    .schematic {
      max-height: 220px;
    }
  }
</style>
