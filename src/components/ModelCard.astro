---
/**
 * ModelCard.astro — one model in the /models catalog grid.
 *
 * Visual language follows FeaturedModels.astro (rounded surface, logo chip
 * top-left, vendor + modality pill, mono model id, watermark logo bottom-
 * right, mono price line). Compact variant — 3 lines of body max, no blurb.
 *
 * The card is rendered as a <li> with data-* attributes so ModelsExplorer's
 * vanilla JS can filter (hidden attribute) and sort (style.order) without
 * touching markup.
 */
import {
  priceLabel,
  modalityLabel,
  vendorSlug,
  vendorDisplayName,
} from '../data/pricing.ts';
import { modelDetailPath, type ModelWithSlug } from '../data/model-slug.ts';
import { i18n, type Locale } from '../i18n.ts';

interface Props {
  model: ModelWithSlug;
  locale?: Locale;
}
const { model, locale = 'zh' } = Astro.props as Props;
const t = i18n[locale];

const vSlug = vendorSlug(model.vendor);
const detailHref = modelDetailPath(model.slug, locale);
const price = priceLabel(model, locale);
const vendorName = vendorDisplayName(model.vendor, locale);
const showTags =
  Boolean(model.tags) &&
  (locale === 'zh' || !/[\u3400-\u9fff]/.test(model.tags ?? ''));
const sortInput = model.inputPriceUsd;
const sortOutput = model.outputPriceUsd;
---

<li
  class="modelcard"
  data-modality={model.modality}
  data-vendor={vSlug}
  data-name={model.model_name.toLowerCase()}
  data-input-price={sortInput}
  data-output-price={sortOutput}
>
  <a
    class="modelcard__open"
    href={detailHref}
    aria-label={t.models.cardAria(model.model_name)}
  >
    <img
      class="modelcard__watermark"
      src={model.iconUrl}
      alt=""
      loading="lazy"
      aria-hidden="true"
      onerror="this.style.display='none'"
    />

    <div class="modelcard__top">
      <span class="modelcard__logo">
        <img
          src={model.iconUrl}
          alt={`${vendorName} logo`}
          loading="lazy"
          onerror="this.style.display='none'"
        />
      </span>
      <span class="modelcard__vendor">{vendorName}</span>
      <span class="modelcard__modality mono"
        >{modalityLabel(model.modality, locale)}</span
      >
    </div>

    <div class="modelcard__body">
      <p class="modelcard__id mono">{model.model_name}</p>
      {showTags && <p class="modelcard__tag mono">{model.tags}</p>}
    </div>

    <p class="modelcard__price mono">
      {price}
      <span class="modelcard__more" aria-hidden="true">→</span>
    </p>
  </a>
</li>

<style>
  .modelcard {
    list-style: none;
    min-width: 0;
  }

  .modelcard__open {
    border-radius: var(--radius-lg);
    padding: 20px 20px 18px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    width: 100%;
    min-height: 188px;
    position: relative;
    overflow: hidden;
    isolation: isolate;
    text-align: left;
    text-decoration: none;
    background:
      linear-gradient(
        135deg,
        rgba(255, 255, 255, 0.98),
        rgba(246, 249, 252, 0.72)
      ),
      var(--color-canvas);
    border: 1px solid var(--color-hairline);
    color: var(--color-ink);
    box-shadow: var(--shadow-1);
    cursor: pointer;
    transition:
      transform 320ms var(--ease-out-quart),
      border-color 320ms var(--ease-out-quart),
      box-shadow 320ms var(--ease-out-quart);
  }

  .modelcard__open:hover {
    transform: translateY(-3px);
    border-color: rgba(83, 58, 253, 0.22);
    box-shadow: var(--shadow-2);
  }

  .modelcard__open::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        circle at 96% 94%,
        rgba(83, 58, 253, 0.055),
        transparent 34%
      ),
      linear-gradient(
        135deg,
        rgba(255, 255, 255, 0.66) 0%,
        rgba(255, 255, 255, 0) 58%
      );
    z-index: 0;
    pointer-events: none;
  }

  .modelcard__watermark {
    position: absolute;
    right: 14px;
    bottom: 18px;
    width: 64px;
    height: 64px;
    object-fit: contain;
    opacity: 0.14;
    z-index: 1;
    transform: scale(1);
    transform-origin: 78% 78%;
    transition:
      transform 420ms var(--ease-out-quart),
      opacity 420ms var(--ease-out-quart);
    pointer-events: none;
  }

  .modelcard__open:hover .modelcard__watermark {
    transform: scale(1.18);
    opacity: 0.22;
  }

  .modelcard__top {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
    position: relative;
    z-index: 2;
  }

  .modelcard__logo {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 999px;
    background: var(--color-canvas-soft);
    border: 1px solid var(--color-hairline);
    flex-shrink: 0;
    overflow: hidden;
    color: var(--color-ink);
  }

  .modelcard__logo img {
    width: 16px;
    height: 16px;
    object-fit: contain;
  }

  :global(.modelcard__logo-fallback) {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: var(--weight-medium);
    color: var(--color-ink-secondary);
    line-height: 1;
  }

  .modelcard__vendor {
    font-size: 12.5px;
    letter-spacing: -0.01em;
    color: var(--color-ink-secondary);
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .modelcard__modality {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 3px 8px;
    border: 1px solid currentColor;
    border-radius: var(--radius-pill);
    color: var(--color-ink-mute);
    flex-shrink: 0;
  }

  .modelcard__body {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 6px;
    position: relative;
    z-index: 2;
  }

  .modelcard__id {
    font-size: clamp(15px, 1.4vw, 18px);
    line-height: 1.18;
    letter-spacing: -0.015em;
    font-weight: var(--weight-medium);
    word-break: break-all;
  }

  .modelcard__tag {
    font-size: 10px;
    color: var(--color-ink-mute);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .modelcard__price {
    font-size: 11px;
    letter-spacing: -0.005em;
    border-top: 1px solid var(--color-hairline);
    padding-top: 12px;
    margin-top: auto;
    color: var(--color-ink-mute);
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
  }

  .modelcard__more {
    color: var(--color-primary);
    font-size: 13px;
    transition: transform 200ms var(--ease-out-quart);
  }

  .modelcard__open:hover .modelcard__more {
    transform: translateX(3px);
  }

  @media (max-width: 720px) {
    .modelcard__open {
      min-height: 172px;
      padding: 16px 16px 14px;
      gap: 14px;
    }
    .modelcard__id {
      font-size: 14.5px;
    }
  }
</style>
