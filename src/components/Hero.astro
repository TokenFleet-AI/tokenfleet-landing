---
/**
 * Hero.astro — fal.ai-style two-column hero on a FaultyTerminal CRT backdrop.
 *
 * Left:   eyebrow → Sohne thin headline → body lead → primary + outline CTA →
 *         mono trust line. Rendered in dark ink over a pale terminal field.
 * Right:  three-tab code block (curl / Python / Node) — kept on its white
 *         surface so the panel reads as a code window floating above the
 *         white-purple WebGL field.
 *
 * Background: HeroBackdrop hosts the WebGL FaultyTerminal island + a pale
 * white-purple CSS fallback (SSR / no-WebGL safety).
 *
 * Keyboard: ←/→ cycle tabs; Tab+Enter activates copy.
 * Mobile (<880px): columns collapse vertically, code block keeps horizontal
 * scroll because forcing line-wrap on real SDK code would lie about it.
 */

import HeroBackdrop from './HeroBackdrop.astro';
import CodeBlock from './CodeBlock.astro';
import { totalModelCount } from '../data/pricing.ts';
import { i18n, localePath, type Locale } from '../i18n.ts';
import { DASHBOARD_URL, DOCS_URL } from '../site-links.ts';

interface Props {
  locale?: Locale;
}

const { locale = 'zh' } = Astro.props as Props;
const t = i18n[locale];
const total = totalModelCount();
---

<section class="hero">
  <HeroBackdrop />

  <div class="container hero__inner">
    <div class="hero__copy">
      <span class="eyebrow">{t.hero.eyebrow}</span>

      <h1 class="hero__headline">
        <span class="voltage">{t.hero.titlePrefix}</span>{
          locale === 'zh' ? '，' : ''
        }<br />
        {t.hero.titleRest}
      </h1>

      <p class="hero__body">
        {t.hero.bodyBefore}
        <strong class="hero__body-num mono">{total}</strong>
        {t.hero.bodyAfter}
      </p>

      <div class="hero__cta">
        <a href={DASHBOARD_URL} class="btn btn--primary btn--lg">
          {t.nav.start}
          <svg
            width="14"
            height="14"
            viewBox="0 0 14 14"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M5 3l4 4-4 4"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </a>
        <a href={DOCS_URL} class="btn btn--outline btn--lg" rel="noopener">
          {t.hero.docs}
        </a>
      </div>

      <ul class="hero__trust" aria-label={t.hero.trustAria}>
        <li>
          <a class="hero__trust-link" href={localePath(locale, '/models')}
            >{t.hero.trustModels(total)}</a
          >
        </li>
        <li>{t.hero.trustGateway}</li>
        <li>{t.hero.trustDirect}</li>
      </ul>
    </div>

    <div class="hero__panel">
      <CodeBlock locale={locale} />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: clamp(48px, 8vw, 96px);
    padding-bottom: clamp(64px, 9vw, 128px);
    overflow: hidden;
    color: var(--color-ink);
  }

  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: var(--z-mesh);
    background: linear-gradient(
      90deg,
      rgba(255, 255, 255, 0.76) 0%,
      rgba(255, 255, 255, 0.48) 38%,
      rgba(255, 255, 255, 0.16) 66%,
      rgba(255, 255, 255, 0) 100%
    );
    pointer-events: none;
  }

  .hero__inner {
    position: relative;
    z-index: var(--z-content);
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    align-items: center;
    gap: clamp(40px, 5vw, 72px);
  }

  .hero__copy {
    display: flex;
    flex-direction: column;
    gap: 24px;
    min-width: 0;
  }

  .hero__copy :global(.eyebrow) {
    color: var(--color-primary-press);
    margin-bottom: -4px;
  }

  .hero__headline {
    font-size: var(--type-display-xxl-size);
    line-height: var(--type-display-xxl-line);
    letter-spacing: var(--type-display-xxl-track);
    font-weight: var(--weight-medium);
    color: var(--color-ink);
    max-width: 18ch;
    overflow-wrap: anywhere;
    text-shadow: 0 1px 0 rgba(255, 255, 255, 0.72);
  }

  .hero__headline :global(.voltage) {
    color: var(--color-primary);
    font-weight: var(--weight-semibold);
    text-shadow:
      0 1px 0 rgba(255, 255, 255, 0.72),
      0 0 24px rgba(83, 58, 253, 0.2);
  }

  .hero__body {
    font-size: var(--type-body-lg-size);
    line-height: 1.55;
    color: var(--color-ink-secondary);
    max-width: 36ch;
    font-weight: var(--weight-regular);
    overflow-wrap: anywhere;
    text-shadow: 0 1px 0 rgba(255, 255, 255, 0.68);
  }

  .hero__body-num {
    font-weight: var(--weight-medium);
    color: var(--color-primary-press);
    font-size: 1.06em;
    margin: 0 2px;
  }

  .hero__cta {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 4px;
  }

  /* Secondary CTA sits on a white surface so it remains crisp on the pale
     terminal field while staying quieter than the indigo primary action. */
  .hero__cta :global(.btn--outline) {
    color: var(--color-brand-dark-900);
    border-color: rgba(83, 58, 253, 0.28);
    background: rgba(255, 255, 255, 0.86);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.72) inset,
      0 10px 26px rgba(83, 58, 253, 0.1);
  }
  .hero__cta :global(.btn--outline:hover) {
    color: var(--color-primary-press);
    background: var(--color-on-primary);
    border-color: var(--color-on-primary);
    transform: translateY(-1px);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.82) inset,
      0 14px 32px rgba(0, 0, 0, 0.24);
  }

  .hero__trust {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    color: var(--color-ink-mute);
    font-size: var(--type-caption-size);
    margin-top: 12px;
  }

  .hero__trust li {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .hero__trust li:not(:last-child)::after {
    content: '';
    display: inline-block;
    width: 3px;
    height: 3px;
    border-radius: 999px;
    background: rgba(83, 58, 253, 0.28);
    margin-left: 12px;
    opacity: 0.8;
  }

  .hero__trust li:last-child::after {
    display: none;
  }

  .hero__trust .mono {
    color: var(--color-primary-press);
    font-weight: var(--weight-medium);
  }

  .hero__trust-link {
    color: inherit;
    border-bottom: 1px solid transparent;
    transition:
      border-color var(--motion-base) var(--ease-out-quart),
      color var(--motion-base) var(--ease-out-quart);
  }
  .hero__trust-link:hover {
    color: var(--color-primary-soft);
    border-bottom-color: currentColor;
  }

  .hero__panel {
    position: relative;
    min-width: 0;
    max-width: 100%;
    filter: drop-shadow(0 24px 48px rgba(83, 58, 253, 0.18))
      drop-shadow(0 4px 10px rgba(28, 30, 84, 0.12));
  }

  @media (max-width: 960px) {
    .hero__inner {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .hero__headline {
      max-width: 22ch;
    }
    .hero__body {
      max-width: 48ch;
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding-top: 32px;
      padding-bottom: 72px;
    }
    .hero__inner {
      gap: 36px;
    }
    .hero__copy {
      gap: 20px;
    }
    .hero__headline {
      max-width: 11ch;
      font-size: clamp(38px, 12vw, 44px);
      line-height: 1.06;
    }
    .hero__body {
      max-width: 100%;
      font-size: 15px;
      line-height: 1.6;
    }
    .hero__cta {
      gap: 10px;
    }
    .hero__cta .btn {
      flex: 1 1 144px;
      justify-content: center;
      min-height: 44px;
      padding-inline: 16px;
    }
    .hero__trust {
      gap: 8px 12px;
      margin-top: 8px;
    }
    .hero__trust li:not(:last-child)::after {
      margin-left: 6px;
    }
  }
</style>
