---
/**
 * Enterprise.astro — single dark band on the entire page.
 *
 * Decision 5 v2 boundary: this band serves engineering-side enterprise
 * capability (SLA, VPC, dedicated technical contact). Finance reader
 * concerns (invoice, contract, RBAC) are already served by §5 Built for
 * Business. The two sections do NOT overlap.
 *
 * Hard rule: NEVER claim SOC 2, ISO 27001, HIPAA, or specific uptime
 * percentages we have not actually contracted for. Copy reflects "可商谈
 * / 可定制" wording until the legal team confirms each badge.
 */
import { i18n, type Locale } from '../i18n.ts';
import { withBase } from '../base.ts';
import SalesQrLightbox from './SalesQrLightbox.astro';

interface Props {
  locale?: Locale;
}

const { locale = 'zh' } = Astro.props as Props;
const t = i18n[locale];
const labels = t.enterprise.labels.map(([eyebrow, title, body]) => ({
  eyebrow,
  title,
  body,
}));

/**
 * 背景图走 CSS 自定义属性，而不是在 `<style>` 里写死 `url('/images/...')`：
 * `<style>` 是纯 CSS，拿不到 `withBase()`，子路径部署（GitHub Pages）下写死的
 * 绝对路径会 404。变量定义在本组件根 `<section>` 上，`.enterprise__bg` 继承。
 */
const bgVars = [
  [
    '--enterprise-bg-lg-avif',
    '/images/enterprise-production-scale-bg-1600.avif',
  ],
  [
    '--enterprise-bg-lg-webp',
    '/images/enterprise-production-scale-bg-1600.webp',
  ],
  [
    '--enterprise-bg-sm-avif',
    '/images/enterprise-production-scale-bg-960.avif',
  ],
  [
    '--enterprise-bg-sm-webp',
    '/images/enterprise-production-scale-bg-960.webp',
  ],
]
  .map(([name, path]) => `${name}: url('${withBase(path)}')`)
  .join('; ');
---

<section
  class="enterprise"
  id="enterprise"
  aria-labelledby="enterprise-title"
  style={bgVars}
>
  <div class="enterprise__bg" aria-hidden="true"></div>

  <div class="container enterprise__inner">
    <div class="enterprise__lede" data-reveal>
      <span class="eyebrow eyebrow--on-dark">{t.enterprise.eyebrow}</span>
      <h2 class="enterprise__title" id="enterprise-title">
        {t.enterprise.title}
      </h2>
      <p class="enterprise__body">
        {t.enterprise.body}
      </p>
    </div>

    <ol class="enterprise__labels" data-reveal>
      {
        labels.map((l) => (
          <li>
            <span class="eyebrow eyebrow--on-dark">{l.eyebrow}</span>
            <h3 class="enterprise__label-title">{l.title}</h3>
            <p class="enterprise__label-body">{l.body}</p>
          </li>
        ))
      }
    </ol>

    <div class="enterprise__cta" data-reveal>
      <SalesQrLightbox
        id={`enterprise-sales-qr-${locale}`}
        title={t.salesQr.title}
        caption={t.salesQr.caption}
        alt={t.salesQr.alt}
        closeLabel={t.salesQr.close}
        triggerClass="btn btn--primary btn--lg"
      >
        <Fragment slot="trigger">
          {t.enterprise.cta}
          <svg
            width="14"
            height="14"
            viewBox="0 0 14 14"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M5 3l4 4-4 4"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </Fragment>
      </SalesQrLightbox>
      <p class="enterprise__cta-note mono">
        {t.enterprise.note}
      </p>
    </div>
  </div>
</section>

<style>
  .enterprise {
    position: relative;
    background: var(--color-brand-dark-900);
    color: var(--color-on-primary);
    overflow: hidden;
    isolation: isolate;
  }

  /* Photo-backed infrastructure atmosphere, kept dark enough for copy. */
  .enterprise__bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    opacity: 1;
    background:
      linear-gradient(
        90deg,
        rgba(7, 12, 30, 0.96) 0%,
        rgba(10, 16, 42, 0.9) 36%,
        rgba(13, 18, 46, 0.58) 100%
      ),
      linear-gradient(180deg, rgba(28, 30, 84, 0.2), rgba(11, 14, 36, 0.88)),
      image-set(
        var(--enterprise-bg-lg-avif) type('image/avif'),
        var(--enterprise-bg-lg-webp) type('image/webp')
      );
    background-size: cover;
    background-position: center right;
  }

  .enterprise__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: clamp(40px, 5vw, 64px);
  }

  .enterprise__lede {
    max-width: 640px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .enterprise__title {
    font-size: var(--type-display-xl-size);
    line-height: var(--type-display-xl-line);
    letter-spacing: var(--type-display-xl-track);
    font-weight: var(--weight-thin);
    color: var(--color-on-primary);
  }

  .enterprise__body {
    color: var(--color-on-dark-mute);
    font-size: var(--type-body-lg-size);
    line-height: 1.6;
    max-width: 48ch;
    font-weight: var(--weight-regular);
  }

  .enterprise__labels {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
    padding-top: 28px;
    border-top: 1px solid var(--color-hairline-dark);
  }

  .enterprise__labels li {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .enterprise__label-title {
    font-size: var(--type-heading-md-size);
    color: var(--color-on-primary);
    line-height: 1.3;
    font-weight: var(--weight-regular);
    letter-spacing: -0.012em;
  }

  .enterprise__label-body {
    color: var(--color-on-dark-mute);
    font-size: 14px;
    line-height: 1.55;
    max-width: 32ch;
  }

  .enterprise__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 24px;
    padding-top: 24px;
    border-top: 1px solid var(--color-hairline-dark);
  }

  .enterprise__cta-note {
    font-size: 12px;
    color: var(--color-on-dark-mute);
  }

  @media (max-width: 768px) {
    .enterprise__bg {
      background:
        linear-gradient(
          90deg,
          rgba(7, 12, 30, 0.98) 0%,
          rgba(10, 16, 42, 0.92) 48%,
          rgba(13, 18, 46, 0.74) 100%
        ),
        linear-gradient(180deg, rgba(28, 30, 84, 0.24), rgba(11, 14, 36, 0.9)),
        image-set(
          var(--enterprise-bg-sm-avif) type('image/avif'),
          var(--enterprise-bg-sm-webp) type('image/webp')
        );
      background-size: cover;
      background-position: 58% center;
    }

    .enterprise__labels {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }
</style>
