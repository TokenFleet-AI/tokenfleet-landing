---
import Base from '../../layouts/Base.astro';
import TopNav from '../../components/TopNav.astro';
import Hero from '../../components/Hero.astro';
import BrandStrip from '../../components/BrandStrip.astro';
import FeaturedModels from '../../components/FeaturedModels.astro';
import TriCard from '../../components/TriCard.astro';
import WhyUs from '../../components/WhyUs.astro';
import Enterprise from '../../components/Enterprise.astro';
import Faq from '../../components/Faq.astro';
import Footer from '../../components/Footer.astro';
import { i18n, localePath } from '../../i18n.ts';
import { faqPageSchema } from '../../seo/faq-schema.ts';

const locale = 'en';
const t = i18n[locale];
---

<Base
  locale={locale}
  title={t.seo.homeTitle}
  description={t.seo.homeDescription}
  canonical={new URL(localePath(locale, '/'), Astro.site).toString()}
  alternateZh={new URL('/', Astro.site).toString()}
  alternateEn={new URL('/en', Astro.site).toString()}
  jsonLd={faqPageSchema(t.faq.items)}
>
  <TopNav locale={locale} currentPath="/" />
  <main id="main">
    <Hero locale={locale} />
    <BrandStrip locale={locale} />
    <FeaturedModels locale={locale} />
    <TriCard locale={locale} />
    <WhyUs locale={locale} />
    <Enterprise locale={locale} />
    <Faq locale={locale} />
  </main>
  <Footer locale={locale} />
</Base>
