---
import ModelDetailPage from '../../../components/ModelDetailPage.astro';
import {
  modelsWithSlug,
  type ModelWithSlug,
} from '../../../data/model-slug.ts';

export function getStaticPaths() {
  return modelsWithSlug().map((model) => ({
    params: { slug: model.slug },
    props: { model },
  }));
}

const { model } = Astro.props as { model: ModelWithSlug };
---

<ModelDetailPage locale="en" model={model} />
